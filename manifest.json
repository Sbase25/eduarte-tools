{
  "manifest_version": 3,
  "name": "Eduarte Tools",
  "version": "2.4.0",
  "description": "Automatisch inloggen, donkere modus, thema's en een cijfercalculator voor Eduarte-portalen. Geïnspireerd door Study Tools.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup-dist/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "geolocation",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/wallpaper-human.jpg"
      ],
      "matches": [
        "https://*.educus.nl/*",
        "https://*.eduarte.nl/*"
      ]
    }
  ],
  "host_permissions": [
    "https://*.educus.nl/*",
    "https://*.eduarte.nl/*",
    "https://login.microsoftonline.com/*",
    "https://*.onderwijsgroeptilburg.nl/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://*.microsoftonline.com/*",
    "https://login.microsoft.com/*",
    "https://login.live.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.educus.nl/*",
        "https://*.eduarte.nl/*"
      ],
      "css": [
        "popup-dist/context-menu.css"
      ],
      "js": [
        "eduarte-api.js",
        "grade-calculator.js",
        "overlay.js",
        "badge-logic.js",
        "badge.js",
        "popup-dist/context-menu.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.educus.nl/*",
        "https://*.eduarte.nl/*",
        "https://*.microsoftonline.com/*",
        "https://login.microsoft.com/*",
        "https://login.live.com/*",
        "https://*.onderwijsgroeptilburg.nl/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.educus.nl/*",
        "https://*.eduarte.nl/*"
      ],
      "js": [
        "theme.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}