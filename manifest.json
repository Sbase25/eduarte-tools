{
  "manifest_version": 3,
  "name": "Eduarte Tools",
  "version": "1.0.3",
  "description": "Automatisch inloggen, donkere modus, thema's en een cijfercalculator voor Eduarte-portalen. Geïnspireerd door Study Tools.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.educus.nl/*",
    "https://*.eduarte.nl/*",
    "https://login.microsoftonline.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/wallpaper-human.jpg"],
      "matches": [
        "https://*.educus.nl/*",
        "https://*.eduarte.nl/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.educus.nl/*",
        "https://*.eduarte.nl/*",
        "https://login.microsoftonline.com/*"
      ],
      "js": ["content.js", "overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.educus.nl/*",
        "https://*.eduarte.nl/*"
      ],
      "js": ["theme.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
