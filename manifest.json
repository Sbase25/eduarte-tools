{
  "manifest_version": 3,
  "name": "Eduarte Tools",
  "version": "1.0.0",
  "description": "Automatisch inloggen, donkere modus en thema's voor Eduarte Portalen (Onderwijsgroep Tilburg). Geinspireerd door Study Tools voor Magister.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.onderwijsgroeptilburg.nl/*",
    "https://login.microsoftonline.com/*",
    "https://tilburg-student.educus.nl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.onderwijsgroeptilburg.nl/*",
        "https://login.microsoftonline.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://tilburg-student.educus.nl/*"
      ],
      "js": ["theme.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
